[Unit]
Description=Kai Tools - Gateway Service
After=network.target

[Service]
Type=simple
User=kaihero
WorkingDirectory=/opt/kai/kai-tools
ExecStart=/opt/kai/kai-tools/start-gateway-svc.sh

Restart=always
RestartSec=2


Environment=DEMO_LOG_LEVEL=INFO
Environment=LOG_LEVEL=info


Environment=HOST=0.0.0.0
Environment=PORT=9000


Environment=MCP_BASE_URL=http://127.0.0.1:9200


Environment=DEPLOY_MAP_PATH=/opt/kai/kai-tools/gateway/deploy-map.json


Environment=UPSTREAM_CHAT_PATH=/chat/completions
Environment=LOG_FILE=/var/log/kai/gateway.log

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
